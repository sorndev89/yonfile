# Public STUN server used when no TURN credentials are available.
STUN_URL=stun:stun.l.google.com:19302

# Public Coturn endpoint. Set TURN_SHARED_SECRET to the same strong secret
# configured for the coturn container. The API returns ten-minute credentials.
TURN_URL=turn:turn.yonfile.example:3478
TURN_SHARED_SECRET=replace-with-a-long-random-secret
TURN_REALM=turn.yonfile.example

# For native clients, set this at build time, for example:
# flutter build <platform> --dart-define=SIGNALING_URL=wss://yonfile.example/ws
# Web clients discover /api/ice-servers on their current origin.
SIGNALING_URL=wss://yonfile.example/ws
